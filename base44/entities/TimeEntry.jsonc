{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "teamMember": {
      "type": "string",
      "enum": [
        "Chris",
        "Elena",
        "George",
        "Martinique",
        "Sreeja",
        "Ramesh"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Sales & Outbound",
        "Customer Success & Onboarding",
        "Marketing & Content",
        "Operations & Admin",
        "Product & Tech",
        "Finance",
        "Strategy & Planning",
        "Other"
      ]
    },
    "projectTask": {
      "type": "string"
    },
    "durationMinutes": {
      "type": "number",
      "description": "Total duration in minutes"
    },
    "notes": {
      "type": "string"
    },
    "transcriptLink": {
      "type": "string",
      "description": "Optional URL link to a meeting transcript (Fireflies, Otter, Google Doc, etc.)"
    },
    "estimatedMinutes": {
      "type": "number",
      "description": "Optional estimated duration in minutes"
    },
    "timerStatus": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stopped",
        "logged"
      ],
      "description": "Timer state"
    },
    "timerStartedAt": {
      "type": "string",
      "description": "ISO timestamp when the timer was started"
    },
    "timerStoppedAt": {
      "type": "string",
      "description": "ISO timestamp when the timer was stopped"
    },
    "timerPauseIntervals": {
      "type": "string",
      "description": "JSON array of pause/resume interval objects [{pausedAt, resumedAt}]"
    },
    "clientId": {
      "type": "string",
      "description": "Optional linked client ID"
    },
    "clientName": {
      "type": "string",
      "description": "Denormalised client name for display"
    }
  },
  "required": [
    "date",
    "teamMember",
    "category",
    "projectTask",
    "durationMinutes"
  ]
}