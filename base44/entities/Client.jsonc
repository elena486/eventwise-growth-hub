{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "contactName": {
      "type": "string"
    },
    "contactEmail": {
      "type": "string"
    },
    "contactPhone": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "enum": [
        "Chris Carter",
        "Martinique Keeler",
        "Eleanor"
      ]
    },
    "secondaryOwner": {
      "type": "string",
      "enum": [
        "Chris Carter",
        "Martinique Keeler",
        "Eleanor",
        "None"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Trial",
        "Onboarding",
        "Live",
        "Churn"
      ]
    },
    "product": {
      "type": "string",
      "enum": [
        "Only ITL",
        "Only ITL - pursue EW",
        "EW + ITL",
        "Only EW"
      ],
      "description": "Which product/service the client uses \u2014 set manually per client"
    },
    "trialStartDate": {
      "type": "string",
      "format": "date"
    },
    "trialLength": {
      "type": "string",
      "description": "Trial length (e.g. '7 days', '14 days', '30 days', 'Custom') \u2014 set when converting a pipeline lead via Trial Kickoff"
    },
    "renewalDate": {
      "type": "string",
      "format": "date"
    },
    "lastContacted": {
      "type": "string",
      "format": "date"
    },
    "priorityTier": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "description": "How important is this client to the business?"
    },
    "notes": {
      "type": "string"
    },
    "healthScore": {
      "type": "number"
    },
    "healthRating": {
      "type": "string"
    },
    "healthQuadrant": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "handoffIncomplete": {
      "type": "boolean",
      "description": "True if post-conversion handoff checklist is not complete"
    },
    "noReplyLog": {
      "type": "string",
      "description": "JSON array of no-reply entries [{date, note}]"
    },
    "transcripts": {
      "type": "string",
      "description": "JSON array of meeting transcript objects"
    },
    "addedManually": {
      "type": "boolean",
      "description": "True if this client was added manually via the Add Historical Deal flow \u2014 not through pipeline"
    },
    "dealId": {
      "type": "string",
      "description": "Linked deal record ID"
    },
    "converted_from_lead_id": {
      "type": "string",
      "description": "ID of the original Pipeline lead this client was converted from (Trial Kickoff conversion)"
    },
    "activityLog": {
      "type": "string",
      "description": "JSON array of activity log entries [{date, type, label, category, duration, description, teamMember, notes}]"
    },
    "contractDocuments": {
      "type": "string",
      "description": "JSON array of uploaded contract/document objects [{id, name, url, uploadedAt, uploadedBy}]"
    }
  },
  "required": [
    "name"
  ]
}