{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "contactName": {
      "type": "string"
    },
    "contactEmail": {
      "type": "string"
    },
    "contactPhone": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "enum": [
        "Chris Carter",
        "Martinique Keeler",
        "Eleanor"
      ]
    },
    "secondaryOwner": {
      "type": "string",
      "enum": [
        "Chris Carter",
        "Martinique Keeler",
        "Eleanor",
        "None"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Trial",
        "Onboarding",
        "Live",
        "Churn"
      ]
    },
    "product": {
      "type": "string",
      "enum": [
        "Only ITL",
        "Only ITL - pursue EW",
        "EW + ITL",
        "Only EW"
      ],
      "description": "Which product/service the client uses \u2014 set manually per client"
    },
    "trialStartDate": {
      "type": "string",
      "format": "date"
    },
    "trialLength": {
      "type": "string",
      "description": "Trial length (e.g. '7 days', '14 days', '30 days', 'Custom') \u2014 set when converting a pipeline lead via Trial Kickoff"
    },
    "trialEndDate": {
      "type": "string",
      "format": "date",
      "description": "Calculated trial end date (start + length), editable \u2014 set when converting a pipeline lead via Trial Kickoff"
    },
    "trial_monthly_value": {
      "type": "number",
      "description": "Projected monthly value in GBP if the trial converts to a paid deal \u2014 captured at Trial Kickoff"
    },
    "renewalDate": {
      "type": "string",
      "format": "date"
    },
    "lastContacted": {
      "type": "string",
      "format": "date"
    },
    "priorityTier": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "description": "How important is this client to the business?"
    },
    "notes": {
      "type": "string"
    },
    "healthScore": {
      "type": "number"
    },
    "healthRating": {
      "type": "string"
    },
    "healthQuadrant": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "handoffIncomplete": {
      "type": "boolean",
      "description": "Legacy field \u2014 always false now since handover data is captured at creation"
    },
    "handover_status": {
      "type": "string",
      "enum": [
        "Completed",
        "Not Started"
      ],
      "default": "Not Started",
      "description": "Whether the CS handover has been completed. Set to Completed when a client is created via the Confirm Deal modal."
    },
    "handover_completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the handover was completed (set automatically on deal confirmation)"
    },
    "business_goals": {
      "type": "string",
      "description": "Client's main business goals \u2014 captured at deal confirmation"
    },
    "accountant_status": {
      "type": "string",
      "enum": [
        "Internal",
        "External",
        "Eventwise"
      ],
      "description": "The client's current accountant setup (separate from whether our accounting add-on is included)"
    },
    "key_pain_points": {
      "type": "string",
      "description": "Pain points identified during the sales process"
    },
    "red_flags": {
      "type": "string",
      "description": "Any concerns or risks flagged during sales"
    },
    "next_steps": {
      "type": "string",
      "description": "Immediate next steps after handover"
    },
    "handover_priority_tier": {
      "type": "string",
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3",
        "Tier 4"
      ],
      "description": "Priority tier assigned at handover"
    },
    "main_features_demoed": {
      "type": "string",
      "description": "Which features were shown in the demo"
    },
    "what_resonated": {
      "type": "string",
      "description": "What got the client excited during the sales process"
    },
    "objections_raised_addressed": {
      "type": "string",
      "description": "Objections raised during the trial and how they were addressed (trial-specific handover field)"
    },
    "conversion_risk": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "description": "Owner's read on the likelihood of this trial client converting to a paid deal (trial-specific)"
    },
    "what_would_make_them_convert": {
      "type": "string",
      "description": "What would make this trial client convert to a paid deal \u2014 the single most useful field for CS during a trial"
    },
    "features_promised": {
      "type": "string",
      "description": "Features promised or included in the contract"
    },
    "uses_xero": {
      "type": "boolean",
      "description": "Whether the client already uses Xero"
    },
    "current_budgeting_tool": {
      "type": "string",
      "description": "The client's current budgeting tool (if any)"
    },
    "tech_admin_contact_name": {
      "type": "string",
      "description": "Technical / admin contact at the client"
    },
    "expected_go_live_date": {
      "type": "string",
      "format": "date",
      "description": "Expected go-live date"
    },
    "noReplyLog": {
      "type": "string",
      "description": "JSON array of no-reply entries [{date, note}]"
    },
    "transcripts": {
      "type": "string",
      "description": "JSON array of meeting transcript objects"
    },
    "addedManually": {
      "type": "boolean",
      "description": "True if this client was added manually via the Add Historical Deal flow \u2014 not through pipeline"
    },
    "dealId": {
      "type": "string",
      "description": "Linked deal record ID"
    },
    "converted_from_lead_id": {
      "type": "string",
      "description": "ID of the original Pipeline lead this client was converted from (Trial Kickoff conversion)"
    },
    "activityLog": {
      "type": "string",
      "description": "JSON array of activity log entries [{date, type, label, category, duration, description, teamMember, notes}]"
    },
    "contractDocuments": {
      "type": "string",
      "description": "JSON array of uploaded contract/document objects [{id, name, url, uploadedAt, uploadedBy}]"
    }
  },
  "required": [
    "name"
  ]
}