{
  "name": "ApolloWeeklyUpload",
  "type": "object",
  "properties": {
    "weekOf": {
      "type": "string",
      "format": "date",
      "description": "Monday of the selected week (YYYY-MM-DD)"
    },
    "uploadedBy": {
      "type": "string",
      "description": "Name of the person who uploaded"
    },
    "uploadedAt": {
      "type": "string",
      "description": "ISO timestamp of upload"
    },
    "fileName": {
      "type": "string",
      "description": "Original uploaded file name(s), comma-separated if multiple"
    },
    "fileUrl": {
      "type": "string",
      "description": "Stored file URL (first file if multiple)"
    },
    "fileUrls": {
      "type": "string",
      "description": "JSON array of {url, name} objects for all uploaded files"
    },
    "subjectLines": {
      "type": "string",
      "description": "JSON string of manually entered subject lines array"
    },
    "aiSummary": {
      "type": "string",
      "description": "JSON stringified AI summary from Claude"
    },
    "georgesNotes": {
      "type": "string",
      "description": "George's optional commentary for the week"
    },
    "status": {
      "type": "string",
      "enum": [
        "Processing",
        "Processed",
        "Failed"
      ],
      "default": "Processing",
      "description": "Processing status of the upload"
    }
  },
  "required": [
    "weekOf",
    "uploadedBy",
    "fileName",
    "fileUrl",
    "status"
  ]
}