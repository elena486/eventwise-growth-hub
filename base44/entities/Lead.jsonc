{
  "name": "Lead",
  "type": "object",
  "properties": {
    "companyName": {
      "type": "string",
      "description": "Company name"
    },
    "pipeline": {
      "type": "string",
      "enum": [
        "warm",
        "cold"
      ],
      "default": "warm",
      "description": "Which pipeline this lead belongs to \u2014 warm or cold. A lead exists in one pipeline only."
    },
    "contactName": {
      "type": "string",
      "description": "Contact name (legacy / primary contact display name)"
    },
    "contacts": {
      "type": "string",
      "description": "JSON array of contact objects [{id, firstName, lastName, jobTitle, email, phone, primary}]"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "jobTitle": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "linkedInUrl": {
      "type": "string"
    },
    "companyWebsite": {
      "type": "string"
    },
    "companySize": {
      "type": "string",
      "enum": [
        "1\u201310",
        "11\u201350",
        "51\u2013200",
        "201\u2013500",
        "500+"
      ]
    },
    "industry": {
      "type": "string",
      "enum": [
        "Festival",
        "Event Organiser",
        "Event Agency",
        "Corporate Events",
        "Venue",
        "Accountancy",
        "Other"
      ]
    },
    "heardAbout": {
      "type": "string",
      "enum": [
        "LinkedIn",
        "Referral",
        "Inbound",
        "Outbound",
        "Outbound LinkedIn",
        "MQL",
        "Event",
        "EPS (Event Production Show)",
        "EBL (Event Buyers Live)",
        "AAA (Access All Areas)",
        "Other"
      ]
    },
    "leadOwner": {
      "type": "string",
      "enum": [
        "Chris",
        "Ramesh",
        "Elena",
        "George",
        "Eleanor",
        "Dickie"
      ],
      "description": "Who owns this lead"
    },
    "sdr": {
      "type": "string",
      "enum": [
        "George",
        "Chris",
        "Ramesh"
      ],
      "description": "Who booked this demo \u2014 shown as 'Booked By' in the UI. Optional on any prospect, always available to fill in when known."
    },
    "markedAsMql": {
      "type": "boolean",
      "default": false,
      "description": "True if this prospect has been marked as a Marketing Qualified Lead. Settable by anyone, not gated by Source."
    },
    "mqlMarkedDate": {
      "type": "string",
      "format": "date",
      "description": "Date the prospect was marked as MQL \u2014 auto-set when markedAsMql is toggled to Yes, cleared when toggled to No. Updated to the latest date on re-marking. This is what Elena's sprint form auto-pull counts against."
    },
    "plan": {
      "type": "string",
      "enum": [
        "Starter",
        "Growth",
        "Scale",
        "Professional",
        "Custom"
      ],
      "description": "Eventwise plan"
    },
    "dealValueMonthly": {
      "type": "number",
      "description": "Monthly deal value in GBP"
    },
    "setupFee": {
      "type": "number"
    },
    "software_arr": {
      "type": "number",
      "description": "Annual Eventwise software subscription fee (GBP)"
    },
    "services_arr": {
      "type": "number",
      "description": "Annual In The Loop accounting services fee / Co Pilot (GBP)"
    },
    "onboarding_fee": {
      "type": "number",
      "description": "One-off onboarding fee (GBP) \u2014 NOT included in ARR"
    },
    "total_arr": {
      "type": "number",
      "description": "Calculated: software_arr + services_arr. Read-only, auto-updated when either ARR field changes. Onboarding fee is never included."
    },
    "accountingService": {
      "type": "string",
      "enum": [
        "Not included",
        "Included in plan",
        "Included in accounting service fee",
        "Separate fee"
      ],
      "description": "How accounting service is structured"
    },
    "accountingServiceFee": {
      "type": "number",
      "description": "Monthly accounting fee in GBP, only when accountingService = Separate fee"
    },
    "onboardingPlan": {
      "type": "string",
      "enum": [
        "Basic",
        "Standard",
        "Enterprise",
        "Option 1"
      ]
    },
    "proposedStartDate": {
      "type": "string",
      "format": "date"
    },
    "contractLength": {
      "type": "string",
      "enum": [
        "Monthly rolling",
        "6 months",
        "12 months",
        "24 months"
      ]
    },
    "probability": {
      "type": "number"
    },
    "expectedCloseMonth": {
      "type": "string",
      "description": "Expected close month in YYYY-MM format"
    },
    "timelineToDecision": {
      "type": "string"
    },
    "competitorsEvaluating": {
      "type": "string"
    },
    "activityLog": {
      "type": "string",
      "description": "JSON array of activity log entries"
    },
    "transcripts": {
      "type": "string",
      "description": "JSON array of meeting transcript objects"
    },
    "demoCompleted": {
      "type": "boolean"
    },
    "demoDate": {
      "type": "string",
      "format": "date",
      "description": "Date the demo booking was made (shown as 'Booked On' in the UI). This is what the sprint form auto-pull counts against \u2014 it reflects when the person did the work of getting it booked."
    },
    "demoScheduledDate": {
      "type": "string",
      "format": "date",
      "description": "Date the actual demo meeting is scheduled for (the meeting time itself). Useful for the team to know when the meeting is, but NOT what the sprint form pulls from."
    },
    "demoNotes": {
      "type": "string"
    },
    "objections": {
      "type": "string"
    },
    "objectionsAddressed": {
      "type": "string"
    },
    "painPoints": {
      "type": "string"
    },
    "internalNotes": {
      "type": "string"
    },
    "nextAction": {
      "type": "string",
      "description": "Next action to take"
    },
    "nextActionDue": {
      "type": "string",
      "format": "date"
    },
    "followUpReminder": {
      "type": "string",
      "format": "date"
    },
    "followUpNote": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "New Lead",
        "Contacted",
        "Discovery Call",
        "Demo Booked",
        "Proposal Sent",
        "Negotiation",
        "Closed Won",
        "Closed \u2014 Converted to Trial",
        "Closed Lost",
        "On Hold"
      ],
      "description": "Pipeline stage"
    },
    "proposalStatus": {
      "type": "string",
      "enum": [
        "Not sent",
        "Sent",
        "Accepted",
        "Declined"
      ]
    },
    "proposalSentDate": {
      "type": "string",
      "format": "date"
    },
    "fileUrl": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "externalLinks": {
      "type": "string",
      "description": "JSON array of {label, url} objects"
    },
    "lastActivity": {
      "type": "string",
      "description": "ISO timestamp of last activity"
    },
    "notes": {
      "type": "string",
      "description": "Notes about the lead"
    },
    "slack_activity_log": {
      "type": "string",
      "description": "Appended log of pipeline updates posted in #pipeline-updates \u2014 newest entry at top"
    },
    "converted": {
      "type": "boolean",
      "description": "True if lead has been converted to a client"
    },
    "convertedDate": {
      "type": "string"
    },
    "dealId": {
      "type": "string",
      "description": "Linked deal record ID after conversion"
    },
    "converted_to_client_id": {
      "type": "string",
      "description": "ID of the Customer Success client record created when this lead was converted to a Trial via Trial Kickoff"
    },
    "lostReason": {
      "type": "string"
    }
  },
  "required": [
    "companyName"
  ]
}