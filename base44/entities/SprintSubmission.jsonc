{
  "name": "SprintSubmission",
  "type": "object",
  "properties": {
    "memberName": {
      "type": "string"
    },
    "weekStart": {
      "type": "string",
      "description": "ISO date of Monday of that week (YYYY-MM-DD)"
    },
    "answers": {
      "type": "string",
      "description": "JSON stringified answers object"
    },
    "kpi1Value": {
      "type": "number"
    },
    "kpi2Value": {
      "type": "number"
    },
    "selfRating": {
      "type": "string",
      "enum": [
        "on_track",
        "at_risk",
        "off_track"
      ],
      "description": "Self-assessed status for the week"
    },
    "selfRatingReason": {
      "type": "string",
      "description": "Required reason if selfRating is at_risk or off_track"
    }
  },
  "required": [
    "memberName",
    "weekStart"
  ]
}