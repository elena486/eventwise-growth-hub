{
  "name": "Request",
  "type": "object",
  "properties": {
    "requestNumber": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "requestedBy": {
      "type": "string"
    },
    "recipient": {
      "type": "string",
      "enum": [
        "Elena",
        "George"
      ],
      "description": "Who the request is assigned/sent to"
    },
    "assignedTo": {
      "type": "string",
      "enum": [
        "Elena",
        "George",
        "Chris",
        "Martinique",
        "Sreeja",
        "Ramesh"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Marketing",
        "Sales",
        "Operations",
        "Customer Success",
        "Tech/Product",
        "Admin",
        "Design",
        "Content",
        "Ops",
        "Tech",
        "Other",
        "Self"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "To Do",
        "In Progress",
        "Done",
        "Blocked",
        "New",
        "Waiting",
        "Cancelled"
      ],
      "default": "To Do"
    },
    "description": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "extraNotes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachmentUrl": {
      "type": "string"
    },
    "attachmentName": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    },
    "submittedAt": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}