{
  "name": "SuggestedTask",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "email",
        "slack"
      ],
      "default": "email",
      "description": "Where this suggestion came from \u2014 email or Slack"
    },
    "senderName": {
      "type": "string",
      "description": "Name of the sender (email or Slack display name)"
    },
    "senderEmail": {
      "type": "string",
      "description": "Email address of the sender (email source only \u2014 empty for Slack)"
    },
    "subject": {
      "type": "string",
      "description": "Original email subject line (empty for Slack)"
    },
    "body": {
      "type": "string",
      "description": "Plain text body of the email or Slack message"
    },
    "receivedDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of when the email or message was received"
    },
    "sourceLink": {
      "type": "string",
      "description": "URL to open the original message \u2014 Gmail link for email, permalink for Slack"
    },
    "sourceEmailLink": {
      "type": "string",
      "description": "Legacy field \u2014 same as sourceLink for email-sourced records. Kept for backward compatibility with existing records."
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending review",
        "Approved",
        "Dismissed",
        "Expired"
      ],
      "default": "Pending review",
      "description": "Review state \u2014 Pending review items appear in Elena's queue; Approved/Dismissed/Expired are kept for the log"
    },
    "suggestedTitle": {
      "type": "string",
      "description": "AI-suggested clean task-style title"
    },
    "suggestedDescription": {
      "type": "string",
      "description": "AI-suggested one-line description from the message body"
    },
    "requestedBy": {
      "type": "string",
      "description": "Detected team member if sender matches a TeamMember (by email for email source, by name for Slack source) \u2014 carries over to the created task"
    },
    "aiIsTask": {
      "type": "boolean",
      "description": "AI judgement: true if this is a genuine task or request, false for newsletters/automated/FYI/casual chat"
    },
    "aiConfidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "AI confidence in the classification"
    },
    "aiReasoning": {
      "type": "string",
      "description": "Short AI reasoning for the classification decision"
    },
    "reviewedBy": {
      "type": "string",
      "description": "Name of the person who approved or dismissed the item"
    },
    "reviewedDate": {
      "type": "string",
      "format": "date",
      "description": "Date the item was approved or dismissed"
    },
    "createdRequestId": {
      "type": "string",
      "description": "ID of the Request created on the To-Do Board when approved"
    },
    "dismissedReason": {
      "type": "string",
      "description": "Reason for dismissal or expiry \u2014 kept for the dismissed log"
    }
  },
  "required": [
    "senderName"
  ]
}