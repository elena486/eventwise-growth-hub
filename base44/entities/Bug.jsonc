{
  "name": "Bug",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title of the bug"
    },
    "description": {
      "type": "string",
      "description": "What happened, steps to reproduce, expected vs actual"
    },
    "clientId": {
      "type": "string",
      "description": "Linked client ID (optional)"
    },
    "clientName": {
      "type": "string",
      "description": "Denormalised client name for display"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In Progress",
        "Awaiting Client",
        "Resolved",
        "Closed"
      ],
      "default": "Open"
    },
    "reportedBy": {
      "type": "string",
      "enum": [
        "Chris",
        "Elena",
        "George",
        "Martinique",
        "Sreeja",
        "Ramesh",
        "Eleanor",
        "Dickie"
      ],
      "description": "Who reported the bug"
    },
    "assignedTo": {
      "type": "string",
      "enum": [
        "Chris",
        "Elena",
        "George",
        "Martinique",
        "Sreeja",
        "Ramesh",
        "Eleanor",
        "Dickie"
      ],
      "description": "Who is assigned to fix the bug"
    },
    "dateReported": {
      "type": "string",
      "format": "date",
      "description": "Date the bug was reported"
    },
    "dateResolved": {
      "type": "string",
      "format": "date",
      "description": "Date the bug was resolved"
    },
    "resolution": {
      "type": "string",
      "description": "How the bug was resolved"
    },
    "attachmentUrl": {
      "type": "string",
      "description": "URL of uploaded screenshot or file"
    },
    "attachmentName": {
      "type": "string",
      "description": "Original file name of attachment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}