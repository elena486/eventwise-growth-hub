{
  "name": "DemoFormResponse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Respondent name"
    },
    "company": {
      "type": "string",
      "description": "Company name (optional)"
    },
    "dateSubmitted": {
      "type": "string",
      "format": "date",
      "description": "Date the form was submitted \u2014 auto-set on creation"
    },
    "accountingPlatform": {
      "type": "string",
      "description": "Selected accounting platform (Xero / QuickBooks / Sage / FreeAgent / Other or free-text)"
    },
    "usesPOs": {
      "type": "string",
      "description": "Yes or No"
    },
    "ticketingPlatforms": {
      "type": "string",
      "description": "Comma-separated list of ticketing platforms (e.g. Dice, Eventbrite)"
    },
    "ticketsSoldAnnually": {
      "type": "string",
      "description": "Tickets sold annually band",
      "enum": [
        "Under 10,000",
        "10,000\u201350,000",
        "50,000\u2013250,000",
        "250,000+"
      ]
    },
    "techForwardScore": {
      "type": "number",
      "description": "Tech-forward score 1\u201310"
    },
    "financeTeamDescription": {
      "type": "string",
      "description": "Finance team description (long text)"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Attached"
      ],
      "default": "New",
      "description": "Record status"
    },
    "attachedToId": {
      "type": "string",
      "description": "ID of the linked Lead/pipeline record"
    },
    "attachedToName": {
      "type": "string",
      "description": "Denormalised name of the linked pipeline record"
    }
  },
  "required": [
    "name"
  ]
}