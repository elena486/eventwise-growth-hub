{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "columnPreferences": {
      "type": "string",
      "description": "JSON object mapping viewKey -> array of visible column keys, persisted per user for cross-device column visibility"
    }
  },
  "required": [
    "role"
  ]
}